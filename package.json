{
  "name": "llm-translation-app",
  "version": "0.9.2",
  "description": "Desktop app for translation and grammar correction via Vertex AI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win zip"
  },
  "dependencies": {
    "google-auth-library": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.llmtool.app",
    "productName": "LLMTransTool",
    "asar": true,
    "extraResources": [
      {
        "from": "prompts.json",
        "to": "prompts.json"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "node_modules/**"
    ],
    "win": {
      "sign": null,
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    }
  }
}
